# Environment for the end-to-end suite, read by e2e/test-env.ts. Committed on purpose: these are
# local test values only, and a fresh clone can run `pnpm test:e2e` without extra setup.
# Variables already set in the environment (as in CI) take precedence.

BETTER_AUTH_SECRET="e2e-secret-value-that-is-at-least-32-chars"
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/crystal_ski_rental_test"
E2E_PORT="3100"
