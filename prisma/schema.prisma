// Crystal Ski Rental schema. Requirement IDs refer to docs/REQUIREMENTS.md.
//
// User, Session, Account and Verification are the tables Better Auth requires; everything after
// them is the rental domain.
//
// Some guarantees are invisible here because Prisma cannot express them; they live only in migrations.
// `reservation_item_no_overlap` stops a ski from holding two CREATED or ACTIVE reservations that share
// a day (BR-20), with a trigger that keeps each item in step with its reservation's status (both in
// `reservation_items`). `customer_address_invoice_fields` checks which address fields belong to which kind.
//
// Rules that need a message worth showing someone (pricing, lifecycle transitions, rating windows,
// the rental window) are enforced in the service layer.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// USER rents skis. MANAGER runs the shop floor. ADMIN is a manager who also owns the catalogue and
// the staff accounts.
enum Role {
  USER
  MANAGER
  ADMIN
}

enum AddressKind {
  MAILING
  INVOICE
}

enum SkiType {
  PISTE
  ALL_MOUNTAIN
  FREERIDE
  FREESTYLE
}

enum SkiGender {
  MAN
  WOMAN
  KID
  UNISEX
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  EXPERT
}

// CREATED → ACTIVE (picked up) → RETURNED, or CREATED → CANCELLED_BY_USER / CANCELLED_BY_STORE (BR-11).
enum ReservationStatus {
  CREATED
  ACTIVE
  RETURNED
  CANCELLED_BY_USER
  CANCELLED_BY_STORE
}

model User {
  id                    String            @id
  name                  String
  email                 String
  emailVerified         Boolean           @default(false)
  image                 String?
  // Never accepted from the client: Better Auth exposes it with `input: false`.
  role                  Role              @default(USER)
  // A manager's own store: where they may change skis and which front desk they run (FR-64). Empty
  // for admins and customers. Never accepted from the client, like the role.
  storeId               String?
  // Soft delete keeps reservation history truthful. The e-mail stays taken (FR-63).
  deletedAt             DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @default(now()) @updatedAt
  sessions              Session[]
  accounts              Account[]
  reservations          Reservation[]
  modelRatings          ModelRating[]
  pickedUpReservations  Reservation[]     @relation("PickedUpBy")
  returnedReservations  Reservation[]     @relation("ReturnedBy")
  cancelledReservations Reservation[]     @relation("CancelledBy")
  addresses             CustomerAddress[]
  store                 Store?            @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@unique([email])
  @@map("user")
}

// A customer's postal addresses (FR-6): at most one of each kind. The migration adds a check that only
// an invoice address names a recipient and carries company numbers, and that it always names a recipient.
model CustomerAddress {
  id          String      @id @default(uuid(7))
  userId      String
  kind        AddressKind
  // Invoice only: who the invoice is made out to, a person or a company.
  recipient   String?
  // Invoice only, optional: company registration number (IČO) and VAT number (IČ DPH), without spaces.
  companyId   String?
  vatId       String?
  street      String
  // Text, like a store's: "12/A" and "1543/7" are ordinary house numbers.
  houseNumber String
  city        String
  // Without spaces for Slovak and Czech codes, e.g. "03101"; as entered elsewhere.
  zipCode     String
  // ISO 3166-1 alpha-2, e.g. "SK".
  country     String      @default("SK")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @default(now()) @updatedAt
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind])
  @@map("customer_address")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

model Brand {
  id        String     @id @default(uuid(7))
  name      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now()) @updatedAt
  models    SkiModel[]

  @@map("brand")
}

// Price, type, gender and level belong to the model; length belongs to the individual ski (FR-11).
model SkiModel {
  id          String        @id @default(uuid(7))
  brandId     String
  name        String
  type        SkiType
  gender      SkiGender
  skillLevel  SkillLevel
  pricePerDay Decimal       @db.Decimal(10, 2)
  // Denormalised from ModelRating so search can sort and filter without an aggregate join.
  // Recomputed in the same transaction as every rating write. Null means not rated yet.
  avgRating   Decimal?      @db.Decimal(3, 2)
  ratingCount Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt
  brand       Brand         @relation(fields: [brandId], references: [id], onDelete: Restrict)
  skis        Ski[]
  ratings     ModelRating[]

  @@unique([brandId, name])
  @@index([pricePerDay])
  @@index([avgRating])
  @@map("ski_model")
}

model Store {
  id                    String            @id @default(uuid(7))
  name                  String            @unique
  street                String
  // Text, not a number: "12/A" and "1543/7" are ordinary Slovak house numbers.
  houseNumber           String
  city                  String
  // Five digits without the space, e.g. "03101".
  zipCode               String
  phone                 String
  email                 String
  // Intervals per weekday, e.g. "8:00-12:00;13:00-20:00"; null means closed (FR-12, BR-7).
  openingHoursMonday    String?
  openingHoursTuesday   String?
  openingHoursWednesday String?
  openingHoursThursday  String?
  openingHoursFriday    String?
  openingHoursSaturday  String?
  openingHoursSunday    String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @default(now()) @updatedAt
  reservations          Reservation[]
  specialDays           StoreSpecialDay[]
  managers              User[]
  skis                  Ski[]

  @@map("store")
}

// A date on which a store keeps other hours than its weekday's: a public holiday with short hours, or a
// closure (null hours) such as Christmas (BR-7).
model StoreSpecialDay {
  id        String   @id @default(uuid(7))
  storeId   String
  date      DateTime @db.Date
  hours     String?
  // Why, for customers: "Christmas Day".
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, date])
  @@map("store_special_day")
}

model Ski {
  id               String            @id @default(uuid(7))
  // Staff-only (BR-50).
  inventoryCode    String            @unique
  modelId          String
  storeId          String
  lengthCm         Int
  // Offered for rental at all. Distinct from "free for these dates" (BR-22).
  isAvailable      Boolean           @default(true)
  deletedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now()) @updatedAt
  model            SkiModel          @relation(fields: [modelId], references: [id], onDelete: Restrict)
  store            Store             @relation(fields: [storeId], references: [id], onDelete: Restrict)
  reservationItems ReservationItem[]

  @@index([deletedAt, isAvailable])
  @@index([modelId])
  @@index([storeId])
  @@index([lengthCm])
  @@map("ski")
}

model Reservation {
  id                String               @id @default(uuid(7))
  // What the customer quotes at the counter: six capital letters and digits (FR-45).
  code              String               @unique
  userId            String
  // Every ski of a reservation is from this store (BR-6).
  storeId           String
  // Whole days in UTC: startDate inclusive, endDate exclusive, so one rental can end on the day the
  // next begins. The overlap constraint uses the same '[)' range.
  startDate         DateTime             @db.Date
  endDate           DateTime             @db.Date
  // The skis move through the lifecycle together (BR-10).
  status            ReservationStatus    @default(CREATED)
  // Price snapshot at booking time, the sum of the items. Later price changes never touch these (BR-5).
  rentalDays        Int
  discountPercent   Int
  totalPrice        Decimal              @db.Decimal(10, 2)
  // From the customer to the store, optional (FR-36).
  note              String?
  // Who moved the reservation through its lifecycle, and when (BR-13).
  pickedUpAt        DateTime?
  pickedUpById      String?
  returnedAt        DateTime?
  returnedById      String?
  cancelledAt       DateTime?
  cancelledById     String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @default(now()) @updatedAt
  user              User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  store             Store                @relation(fields: [storeId], references: [id], onDelete: Restrict)
  pickedUpBy        User?                @relation("PickedUpBy", fields: [pickedUpById], references: [id], onDelete: SetNull)
  returnedBy        User?                @relation("ReturnedBy", fields: [returnedById], references: [id], onDelete: SetNull)
  cancelledBy       User?                @relation("CancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  items             ReservationItem[]
  addresses         ReservationAddress[]
  rating            ReservationRating?
  openedModelRating ModelRating[]

  @@index([userId, startDate])
  // Front desk: pickups and returns due or overdue at one store.
  @@index([storeId, status, startDate])
  @@index([storeId, status, endDate])
  @@map("reservation")
}

// One ski of a reservation, with its own price snapshot (BR-5).
//
// The dates, and whether they are still held, are copies of the reservation's, because the
// `reservation_item_no_overlap` constraint can only see this table (BR-20). The dates never change;
// a trigger from the same migration keeps `holdsDates` in step with the reservation's status.
model ReservationItem {
  id            String      @id @default(uuid(7))
  reservationId String
  skiId         String
  startDate     DateTime    @db.Date
  endDate       DateTime    @db.Date
  // True while the reservation is CREATED or ACTIVE.
  holdsDates    Boolean     @default(true)
  pricePerDay   Decimal     @db.Decimal(10, 2)
  totalPrice    Decimal     @db.Decimal(10, 2)
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  ski           Ski         @relation(fields: [skiId], references: [id], onDelete: Restrict)

  @@unique([reservationId, skiId])
  // The overlap lookup behind every booking and search.
  @@index([skiId, holdsDates, startDate])
  @@map("reservation_item")
}

// The customer's addresses as they were when booking (FR-36), so later profile edits never change a
// past reservation. Always a mailing address; an invoice address only when it differs from it. The
// migration adds the same check as on `customer_address`.
model ReservationAddress {
  id            String      @id @default(uuid(7))
  reservationId String
  kind          AddressKind
  recipient     String?
  companyId     String?
  vatId         String?
  street        String
  houseNumber   String
  city          String
  zipCode       String
  country       String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@unique([reservationId, kind])
  @@map("reservation_address")
}

// Feedback on the rental experience, one per reservation (BR-40).
model ReservationRating {
  id            String      @id @default(uuid(7))
  reservationId String      @unique
  score         Int
  note          String?
  // The edit window is one hour from here.
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @default(now()) @updatedAt
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@map("reservation_rating")
}

// Feedback on a ski model, one per customer per model (BR-41). Each write goes through a returned
// reservation; `reservationId` and `windowStartedAt` record which one opened the current edit window.
model ModelRating {
  id              String      @id @default(uuid(7))
  modelId         String
  userId          String
  reservationId   String
  windowStartedAt DateTime
  score           Int
  comment         String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @default(now()) @updatedAt
  model           SkiModel    @relation(fields: [modelId], references: [id], onDelete: Cascade)
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  reservation     Reservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  @@unique([modelId, userId])
  @@index([reservationId])
  @@map("model_rating")
}

// Recent sign-in failures and sign-ups per client or per address, to slow down guessing and sign-up
// floods on the public demo. `count` restarts when `windowStartedAt` is older than the limit's window.
model RateLimit {
  key             String   @id
  count           Int
  windowStartedAt DateTime

  @@map("rate_limit")
}
