# Copy to ".env" and fill in. The schema in "src/env.js" validates these at build and start.

# Signs sessions. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Where the app runs. Optional locally (defaults to http://localhost:3000) and on Vercel, where it is
# worked out from the deployment's own variables.
BETTER_AUTH_URL="http://localhost:3000"

# Local Postgres from docker-compose.yml. On Vercel, the Neon integration sets DATABASE_URL (pooled,
# used by the app) and DATABASE_URL_UNPOOLED (direct, used by migrations).
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/crystal_ski_rental"

# Public demo: one-click demo accounts on the landing page and a "data resets daily" notice.
NEXT_PUBLIC_DEMO_MODE="true"

# E-mail. 127.0.0.1 rather than localhost: Docker publishes the port on IPv4 only, and "localhost"
# resolves to ::1 first, which costs every send a long connection timeout.
# Locally this is Mailpit from docker-compose.yml, which catches everything and delivers
# nothing; read it at http://localhost:8025. Without SMTP_HOST and EMAIL_FROM, nothing is sent.
SMTP_HOST="127.0.0.1"
SMTP_PORT="1025"
EMAIL_FROM="Crystal Ski Rental <noreply@localhost>"

# Production only: SMTP_USER and SMTP_PASSWORD for the provider, and EMAIL_CAPTURE_ADDRESS, where mail
# for the seeded demo addresses goes instead of bouncing (e.g. Resend's "delivered@resend.dev").
